{
  "$ref": "#/definitions/case-studies",
  "definitions": {
    "case-studies": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "timeline": {
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hero": {
          "type": "string"
        },
        "heroAlt": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "sage",
            "mist",
            "moss",
            "lichen",
            "dusk"
          ],
          "default": "sage"
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "order": {
          "type": "number",
          "default": 0
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "company",
        "year",
        "summary",
        "role",
        "team",
        "timeline",
        "published"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}