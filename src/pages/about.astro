---
import { Image } from 'astro:assets';
import headshot from '../assets/andy-pyle-headshot.jpg';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperience, getSite, getSkills } from '../lib/data';
import { profilePage } from '../lib/schema';

const [site, experience, skills] = await Promise.all([getSite(), getExperience(), getSkills()]);
const schema = [await profilePage(Astro.site!, new URL(Astro.url.pathname, Astro.site))];
---
<BaseLayout
  title="About"
  description="I'm a frontend engineer on California's Central Coast who came to code through design. I work in React and TypeScript, with a focus on design systems."
  schema={schema}
>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-start gap-14">
    <div class="flex flex-col gap-8">
      <Image
        class:list={[
          // Layout
          'block object-cover object-top max-md:self-center',
          // Sizing
          'aspect-4/5 h-auto w-full max-md:max-w-67.5',
          // Spacing
          'max-md:my-2',
          // Borders
          'rounded-lg border-3 border-line',
          // Effects
          'shadow-lg',
          // Transforms
          '-rotate-2 max-md:rotate-[-1.5deg]',
        ]}
        src={headshot}
        alt="Andy Pyle"
        widths={[270, 380, 684]}
        sizes="(max-width: 720px) 270px, 380px"
        loading="eager"
      />
      <Card tone="lichen">
        <h2 class="text-h4">Get in touch</h2>
        <p class="mt-2 mb-4 text-base text-fg-2">The best way to reach me is a message on LinkedIn.</p>
        <Button class="rounded-md!" href={site.links.linkedin} external icon="linkedin" iconClass="loam-anim-hop">Message me on LinkedIn</Button>
      </Card>
    </div>
    <div class="flex flex-col gap-5.5">
      <h1>About</h1>
      <p class="text-xl">I got into engineering through design. I studied graphic design first, and somewhere along the way realized I was more interested in how interfaces were built than how they were printed. That curiosity pulled me toward code, and I've been chasing that overlap ever since.</p>
      <p class="text-lg text-fg-2">These days I work primarily in React and TypeScript, with a lot of recent focus on design systems. I care about the person on the other side of the screen, but just as much about the engineers building alongside me. Good developer experience and good user experience aren't that different, really.</p>
      <p class="text-lg text-fg-2">When I'm not at a keyboard, you'll find me at a campsite, tending a barbecue, or making music. I live on the Central Coast of California with my wife and our cat, who has strong opinions about my work-from-home setup.</p>
      <div class="mt-3">
        <h2 class="mb-4 text-h3">Experience</h2>
        <Card padding="none">
          <ul class="divide-y-2 divide-dashed divide-subtle">
            {experience.map((x) => (
              <li class="grid grid-cols-[130px_1fr] gap-4 px-5.5 py-4">
                <span class="pt-0.75 font-mono text-sm text-fg-3">{x.when}</span>
                <div><div class="font-display text-xl font-semibold">{x.role}</div><div class="text-base text-fg-2">{x.org}</div></div>
              </li>
            ))}
          </ul>
        </Card>
      </div>

      <div class="mt-3">
        <h2 class="mb-4 text-h3">What I work with</h2>
        <ul class="flex flex-wrap gap-2.5">{skills.map((s) => <li><Tag>{s}</Tag></li>)}</ul>
      </div>

      <div class="flex flex-wrap gap-3.5 pt-3">
        <Button variant="secondary" iconRight="arrow-right" iconRightClass="loam-anim-dash" href="/case-studies/">See case studies</Button>
      </div>
    </div>
  </div>
</BaseLayout>
