---
import { getCollection } from 'astro:content';
import CaseCard from '../components/CaseCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getSite } from '../lib/data';

const [site, projects] = await Promise.all([getSite(), getProjects()]);
const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
const featured = cases.filter((c) => c.data.featured).slice(0, 2);
---
<BaseLayout>
  <section class="hero">
    <h1>I build careful, considered interfaces, for the person tapping the screen and the teammate reading the code.</h1>
    <p class="lead">Frontend engineer with eight years of experience in React, TypeScript, and design systems.</p>
    <div class="row" style="padding-top:4px">
      <Button size="lg" iconRight="arrow-right" href="/case-studies/">Read case studies</Button>
      <Button size="lg" variant="secondary" href={site.links.linkedin} external icon="linkedin" iconClass="loam-anim-hop">LinkedIn</Button>
    </div>
  </section>

  <section class="section" style="margin-top:112px">
    <SectionHead title="Case studies" action="View all" href="/case-studies/" />
    <div class="stack" style="gap:28px">
      {featured.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>

  {site.features.projects && (
    <section class="section">
      <SectionHead title="Projects" action="All projects" href="/projects/" />
      <div class="grid-cards">
        {projects.slice(0, 3).map((p) => <ProjectCard p={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
