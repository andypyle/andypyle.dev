---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Case studies">
  <h1>Case studies</h1>
  <p class="lead" style="margin-top:16px">Longer write-ups of work I've led: what the problem was, what I built, and what changed.</p>
  <div class="stack" style="gap:28px;margin-top:40px">
    {cases.map((entry) => <CaseCard entry={entry} />)}
  </div>
</BaseLayout>
