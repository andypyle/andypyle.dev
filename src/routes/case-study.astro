---
// Routed to /case-studies/[slug]/ via injectRoute in astro.config.mjs
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import { buttonClass } from '../components/ui/button';
import BaseLayout from '../layouts/BaseLayout.astro';
import { article } from '../lib/schema';

export async function getStaticPaths() {
  const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const schema = [await article(entry, Astro.site!, new URL(Astro.url.pathname, Astro.site))];
const meta = [
  ['Company', d.company + ', ' + d.year],
  ['Role', d.role],
  ['Team', d.team],
  ['Timeline', d.timeline],
  ...(d.stack ? [['Stack', d.stack.join(', ')]] : []),
  ...(d.tags ? [['Focus', d.tags.join(', ')]] : []),
];
---
<BaseLayout title={d.title} description={d.summary} image={d.hero} type="article" schema={schema}>
  <article class="mx-auto max-w-220">
    <Button variant="ghost" size="sm" icon="arrow-left" iconClass="loam-anim-dash-back" href="/case-studies/">All case studies</Button>
    <h1 class="mt-7">{d.title}</h1>
    <p class="mt-4 max-w-content text-2xl text-fg-2">{d.summary}</p>

    <Card tone="sunken" flat class="mt-8">
      <dl class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-5">
        {meta.map(([k, v]) => (
          <div>
            <dt
              class:list={[
                // Colors
                'text-fg-3',
                // Typography
                'font-body text-xs leading-none font-bold tracking-caps uppercase',
              ]}
            >{k}</dt>
            <dd class="mt-2 font-semibold">{v}</dd>
          </div>
        ))}
      </dl>
    </Card>

    {d.hero
      ? <Image
          src={d.hero}
          alt={d.heroAlt ?? ''}
          widths={[880, 1760]}
          sizes="(max-width: 880px) 100vw, 880px"
          loading="eager"
          class:list={[
            // Layout
            'block object-cover',
            // Sizing
            'aspect-[16/8] w-full',
            // Spacing
            'mt-10',
            // Borders
            'rounded-lg border-3 border-line',
            // Effects
            'shadow-lg',
          ]}
        />
      : <Placeholder label="hero shot · before / after" ratio="16/8" framed class="mt-10 shadow-lg" />}

    <div class="loam-prose mx-auto mt-12">
      <Content />
      {d.outcome && <h2>Outcome</h2>}
    </div>
    {d.outcome && (
      <div
        class:list={[
          // Layout
          'grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5',
          // Sizing
          'max-w-content',
          // Spacing
          'mx-auto mt-5',
        ]}
      >
        {d.outcome.map((o) => <Card tone={d.tone} padding="sm"><div class="font-display text-4xl leading-none font-semibold">{o.value}</div><div class="mt-1.5 text-sm text-fg-2">{o.label}</div></Card>)}
      </div>
    )}

    {next.id !== entry.id && (
      <Card class="mt-18" href={'/case-studies/' + next.id + '/'} interactive>
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="font-display text-2xl font-medium">{next.data.title}</div>
          <span class:list={[buttonClass({ size: 'sm' }), 'self-end md:self-auto shrink-0 rounded-md']}>Next case study</span>
        </div>
      </Card>
    )}
  </article>
</BaseLayout>
