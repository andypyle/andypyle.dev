---
// Lays out several <Figure>s side by side (stacks on narrow screens) under one shared caption.
interface Props { caption?: string; class?: string }
const { caption, class: cls } = Astro.props;
---
<figure class:list={[cls]}>
  <div
    class:list={[
      // Layout
      'flex flex-wrap justify-center gap-6',
      // Children
      '*:max-w-80 *:flex-[1_1_220px]',
    ]}
  ><slot /></div>
  {caption && <figcaption class="mt-3 text-center text-sm leading-[1.4] text-fg-2">{caption}</figcaption>}
</figure>
