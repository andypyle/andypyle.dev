---
import IconButton from './ui/IconButton.astro';
import Icon from './ui/Icon.astro';
import { getSite } from '../lib/data';

const site = await getSite();
---
<footer class="mt-28 bg-footer text-footer-fg">
  <div
    class:list={[
      // Layout
      'flex flex-wrap items-center justify-between gap-5',
      // Sizing
      'max-w-page',
      // Spacing
      'mx-auto px-6 py-9 max-md:pb-10',
    ]}
  >
    <div class="flex flex-col gap-1">
      <span class="font-display text-2xl font-semibold">{site.name}</span>
      <span class="text-sm text-footer-muted">{site.role} · Built with love on the Central Coast of California · © {new Date().getFullYear()}</span>
    </div>
    <div class="flex flex-wrap gap-3 self-end">
      <span class="group/tip relative inline-flex">
        <IconButton icon="linkedin" label="LinkedIn" size="sm" href={site.links.linkedin} external iconClass="loam-anim-hop" />
        <span
          class:list={[
            // Layout
            'absolute bottom-[calc(100%+12px)] left-1/2 z-20',
            // Spacing
            'px-2.75 py-1.75',
            // Borders
            'rounded-[8px]',
            // Colors
            'bg-inverse text-fg-inverse',
            // Typography
            'font-body text-sm leading-[1.3] font-semibold whitespace-nowrap',
            // Effects
            'opacity-0 group-focus-within/tip:opacity-100 group-hover/tip:opacity-100',
            // Transforms
            '-translate-x-1/2 translate-y-1 group-focus-within/tip:translate-y-0 group-hover/tip:translate-y-0',
            // Transitions
            'transition-[opacity,translate] duration-200 ease-bounce',
            // Interaction
            'pointer-events-none',
            // ::after: arrow
            'after:absolute after:top-full after:left-1/2',
            'after:size-2.5',
            'after:rounded-[2px]',
            'after:bg-inverse',
            'after:-translate-x-1/2 after:-translate-y-1.5 after:rotate-45',
          ]}
          role="tooltip"
        >LinkedIn</span>
      </span>
    </div>
  </div>
</footer>

{site.email && <div
  class:list={[
    // Layout
    'fixed right-6 bottom-6 z-120 max-md:inset-x-4 max-md:bottom-26',
  ]}
  data-toast
  hidden
>
  <div
    class:list={[
      // Layout
      'flex items-start gap-3',
      // Sizing
      'w-full max-w-95',
      // Spacing
      'py-3.5 pr-3.5 pl-4',
      // Borders
      'rounded-lg border-3 border-line',
      // Colors
      'bg-surface',
      // Effects
      'shadow-md',
      // Animation
      'animate-slide-in',
    ]}
    role="status"
  >
    <span
      class:list={[
        // Layout
        'grid flex-none place-items-center',
        // Sizing
        'size-8.5',
        // Borders
        'rounded-full border-2 border-line',
        // Colors
        'bg-moss-300 text-on-fill',
      ]}
    ><Icon name="check" size={18} /></span>
    <div class="min-w-0 flex-1 pt-0.5">
      <div class="text-base leading-[1.3] font-bold">Email copied</div>
      <div class="mt-0.5 text-sm leading-[1.45] text-fg-2">{site.email}</div>
    </div>
  </div>
</div>}

<script>
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let t: number | undefined;
  document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((el) => {
    el.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(el.dataset.copyEmail || ''); } catch {}
      if (!toast) return;
      toast.hidden = false;
      window.clearTimeout(t);
      t = window.setTimeout(() => { toast.hidden = true; }, 3500);
    });
  });
</script>
