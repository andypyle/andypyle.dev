---
// Image with optional caption for case-study MDX. Inside a FigureGroup, omit caption and let the group caption.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; alt: string; caption?: string; containerClassName?: string; class?: string }
const { src, alt, caption, containerClassName, class: cls } = Astro.props;
---
<figure class:list={[containerClassName, cls]}>
  <Image src={src} alt={alt} widths={[480, 880, 1760]} sizes="(max-width: 880px) 100vw, 880px" class="block h-auto w-full rounded-lg border-3 border-line bg-surface shadow-md" />
  {caption && <figcaption class="mt-3 text-center text-sm leading-[1.4] text-fg-2">{caption}</figcaption>}
</figure>
