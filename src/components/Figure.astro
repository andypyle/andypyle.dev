---
// Image with optional caption for case-study MDX. Inside a FigureGroup, omit caption and let the group caption.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; alt: string; caption?: string; containerClassName?: string; class?: string }
const { src, alt, caption, containerClassName, class: cls } = Astro.props;
---
<figure class:list={['loam-figure', containerClassName, cls]}>
  <Image src={src} alt={alt} widths={[480, 880, 1760]} sizes="(max-width: 880px) 100vw, 880px" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
