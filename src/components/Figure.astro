---
// Image with optional caption for case-study MDX. Inside a FigureGroup, omit caption and let the group caption.
// Pass srcDark to swap in a dark-mode version; it follows the site's theme (OS setting or data-theme).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; srcDark?: ImageMetadata; alt: string; caption?: string; containerClassName?: string; class?: string }
const { src, srcDark, alt, caption, containerClassName, class: cls } = Astro.props;
const imageClass = [
  // Layout
  'block',
  // Sizing
  'h-auto w-full',
  // Borders
  'rounded-lg border-3 border-line',
  // Colors
  'bg-surface',
  // Effects
  'shadow-md',
];
---
<figure class:list={[containerClassName, cls]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 880, 1760]}
    sizes="(max-width: 880px) 100vw, 880px"
    class:list={[imageClass, srcDark && 'dark:hidden']}
  />
  {srcDark && (
    <Image
      src={srcDark}
      alt={alt}
      widths={[480, 880, 1760]}
      sizes="(max-width: 880px) 100vw, 880px"
      class:list={[imageClass, 'hidden dark:block']}
    />
  )}
  {caption && <figcaption class="mt-3 text-center text-sm leading-[1.4] text-fg-2">{caption}</figcaption>}
</figure>
