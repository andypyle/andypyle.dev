---
import type { CollectionEntry } from 'astro:content';
import Card from './ui/Card.astro';
import Placeholder from './ui/Placeholder.astro';
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
// headingLevel follows the page outline: 3 under a section h2 (home), 2 directly under the h1 (case studies index)
interface Props { entry: CollectionEntry<'case-studies'>; headingLevel?: 2 | 3 }
const { entry, headingLevel = 3 } = Astro.props;
const d = entry.data;
const Heading = `h${headingLevel}` as const;
---
<Card href={'/case-studies/' + entry.id + '/'} interactive padding="none" class="group">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))]">
    {d.hero
      ? <Image
          src={d.hero}
          alt=""
          widths={[480, 960]}
          sizes="(max-width: 600px) 100vw, 480px"
          class:list={[
            // Layout
            'block object-cover object-top-left',
            // Sizing
            'aspect-[14/8] w-full',
            // Effects (dimmed in dark mode only)
            'grayscale-50 dark:brightness-80',
            'group-hover:grayscale-0 group-hover:brightness-100',
            'group-focus-visible:grayscale-0 group-focus-visible:brightness-100',
            // Transitions
            'transition-[filter] duration-300 ease-out',
          ]}
        />
      : <Placeholder label={d.company.toLowerCase() + ' · hero shot'} ratio="14/8" />}
    <div
      class:list={[
        // Layout
        'flex flex-col justify-center gap-3',
        // Spacing
        'px-6.5 py-6',
      ]}
    >
      <Heading class="text-h3">{d.title}</Heading>
      <p class="text-base text-fg-2">{d.summary}</p>
      <span class="font-mono text-[13px] text-fg-3">{d.company} · {d.year}</span>
      <span
        class:list={[
          // Layout
          'inline-flex items-center gap-2',
          // Spacing
          'mt-1',
          // Colors
          'text-link',
          // Typography
          'text-[15px] font-bold',
        ]}
      >Read case study <Icon name="arrow-right" size={18} /></span>
    </div>
  </div>
</Card>
