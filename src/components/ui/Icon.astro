---
// Inlines a Lucide icon at build time (lucide-static, pinned). Strokes use currentColor.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 20, class: cls, label } = Astro.props;

const raw = readFileSync(join(process.cwd(), 'node_modules/lucide-static/icons', name + '.svg'), 'utf8');
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\swidth="[^"]*"/, ' width="100%"')
  .replace(/\sheight="[^"]*"/, ' height="100%"')
  .replace(/\sclass="[^"]*"/, '');
---
<span
  class:list={['inline-flex flex-none leading-none', cls]}
  style={'width:' + size + 'px;height:' + size + 'px'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
