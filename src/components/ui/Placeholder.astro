---
// Striped stand-in until real imagery exists. Swap for astro:assets <Image> later.
interface Props { label?: string; ratio?: string; framed?: boolean; class?: string }
const { label = 'image', ratio = '4/3', framed = false, class: cls } = Astro.props;
---
<div
  class:list={[
    // Layout
    'relative grid place-items-center',
    // Sizing
    'w-full',
    // Spacing
    'p-3',
    // Borders
    framed && 'rounded-lg border-3 border-line',
    // Colors
    'bg-[repeating-linear-gradient(135deg,var(--color-sunken)_0_10px,var(--color-page)_10px_20px)] text-fg-2',
    // Typography
    'text-center font-mono text-xs leading-[1.3] font-medium',
    // Overrides
    cls,
  ]}
  style={'aspect-ratio:' + ratio}
><span class="rounded-[4px] border-2 border-line bg-surface px-2 py-1">{label}</span></div>
