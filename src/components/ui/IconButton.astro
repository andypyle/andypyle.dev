---
import Icon from './Icon.astro';
import { buttonClass, type ButtonSize, type ButtonVariant } from './button';

interface Props { icon: string; label: string; variant?: ButtonVariant; size?: ButtonSize; href?: string; external?: boolean; iconClass?: string; class?: string; [key: string]: any }
const { icon, label, variant = 'secondary', size = 'md', href, external = false, iconClass, class: cls, ...rest } = Astro.props;
const is = size === 'sm' ? 16 : size === 'lg' ? 24 : 20;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : { type: 'button' };
---
<Tag class:list={[buttonClass({ variant, size, icon: true }), cls]} aria-label={external ? label + ' (opens in new tab)' : label} {...attrs} {...rest}>
  <Icon name={icon} size={is} class={iconClass} />
</Tag>
