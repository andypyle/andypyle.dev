---
import Icon from './Icon.astro';

interface Props { icon: string; label: string; variant?: 'primary' | 'secondary' | 'dark' | 'ghost'; size?: 'sm' | 'md' | 'lg'; href?: string; external?: boolean; iconClass?: string; class?: string; [key: string]: any }
const { icon, label, variant = 'secondary', size = 'md', href, external = false, iconClass, class: cls, ...rest } = Astro.props;
const is = size === 'sm' ? 16 : size === 'lg' ? 24 : 20;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : { type: 'button' };
---
<Tag class:list={['loam-btn', 'loam-btn--' + variant, 'loam-btn--' + size, 'loam-btn--icon', cls]} aria-label={label} title={label} {...attrs} {...rest}>
  <Icon name={icon} size={is} class={iconClass} />
</Tag>
