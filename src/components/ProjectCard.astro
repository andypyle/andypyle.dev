---
import type { Project } from '../lib/data';
import Card from './ui/Card.astro';
import Placeholder from './ui/Placeholder.astro';
import Button from './ui/Button.astro';
interface Props { p: Project }
const { p: entry } = Astro.props;
const p = entry.data;
---
<Card class="flex flex-col" padding="none" data-kind={p.kind}>
  <Placeholder label={p.title.toLowerCase() + ' · screenshot'} ratio="16/10" class="border-b-3 border-line" />
  <div class="flex flex-1 flex-col gap-2 px-5 pt-4.5 pb-5">
    <h4 class="text-2xl">{p.title}</h4>
    <p class="flex-1 text-[15px] text-fg-2">{p.blurb}</p>
    <div class="flex items-center justify-between gap-3 pt-2">
      <span class="font-mono text-xs text-fg-3">{p.year} · {p.stack.join(' · ')}</span>
      <div class="flex flex-wrap gap-2">
        {p.code && <Button size="sm" variant="secondary" icon="github" href={p.code} external>Code</Button>}
        {p.live && <Button size="sm" iconRight="arrow-up-right" href={p.live} external>Live</Button>}
      </div>
    </div>
  </div>
</Card>
