---
import { Image } from 'astro:assets';
import { hasProjectPage, type Project } from '../lib/data';
import Card from './ui/Card.astro';
import Placeholder from './ui/Placeholder.astro';
import Button from './ui/Button.astro';
// headingLevel follows the page outline: 3 under a section h2 (home), 2 directly under the h1 (projects page)
interface Props { p: Project; headingLevel?: 2 | 3 }
const { p: entry, headingLevel = 3 } = Astro.props;
const p = entry.data;
const Heading = `h${headingLevel}` as const;
// Projects with a detail page get a card-wide link; the Code/Live buttons sit above it
const href = hasProjectPage(entry) ? '/projects/' + entry.id + '/' : undefined;
---
<Card
  class:list={[
    'relative flex flex-col',
    href && 'has-focus-visible:outline-3 has-focus-visible:outline-offset-3 has-focus-visible:outline-focus',
  ]}
  padding="none"
  interactive={Boolean(href)}
  data-kind={p.kind}
>
  {p.image
    ? <Image
        src={p.image}
        alt={p.imageAlt ?? ''}
        widths={[400, 800]}
        sizes="(max-width: 600px) 100vw, 400px"
        class="block aspect-16/10 w-full border-b-3 border-line object-cover object-top-left"
      />
    : <Placeholder label={p.title.toLowerCase() + ' · screenshot'} ratio="16/10" class="border-b-3 border-line" />}
  <div
    class:list={[
      // Layout
      'flex flex-1 flex-col gap-2',
      // Spacing
      'px-5 pt-4.5 pb-5',
    ]}
  >
    <Heading class="text-2xl">
      {href
        ? <a
            href={href}
            class:list={[
              // Colors
              'text-fg-1 hover:text-fg-1',
              // Typography
              'font-[inherit] no-underline',
              // Focus (the card draws the ring)
              'focus-visible:outline-none',
              // ::after: covers the card so it's all clickable
              'after:absolute after:inset-0',
            ]}
          >{p.title}</a>
        : p.title}
    </Heading>
    <!-- Separators trail each item, so a wrapped line never starts with one -->
    <ul class="flex flex-wrap gap-x-2 font-mono text-xs text-fg-3">
      {[p.year, ...p.stack].map((s) => <li class="not-last:after:ml-2 not-last:after:content-['·']">{s}</li>)}
    </ul>
    <p class="mt-1 flex-1 text-base text-fg-2">{p.blurb}</p>
    {(p.code || p.live) && (
      <div class="relative z-1 mt-3 flex flex-wrap gap-2">
        {p.code && <Button size="sm" variant="secondary" icon="github" href={p.code} external>Code</Button>}
        {p.live && <Button size="sm" iconRight="arrow-up-right" href={p.live} external>Live</Button>}
      </div>
    )}
  </div>
</Card>
