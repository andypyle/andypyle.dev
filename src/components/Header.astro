---
import Button from './ui/Button.astro';
import { getSite } from '../lib/data';

const site = await getSite();
const { nav } = site;
const path = Astro.url.pathname;
const current = nav.find((n) => (n.href === '/' ? path === '/' : path.startsWith(n.href)))?.id;
const settle = 'transition-[border-color,background-color,box-shadow] duration-200 ease-out';
---
<header
  class:list={[
    // Group
    'group/header',
    // Layout
    'sticky top-4 z-10',
    // Spacing
    'mt-4 px-4',
  ]}
  data-header
>
  <div class:list={[
    // Layout
    'flex flex-wrap items-center gap-5 max-md:justify-center',
    // Sizing
    'max-w-[calc(var(--container-page)-16px)]',
    // Spacing
    'mx-auto py-2.5 pr-3 pl-5 max-md:px-5 max-md:py-4.5',
    // Borders
    'rounded-md border-3 border-transparent group-data-scrolled/header:border-line',
    // Colors
    'bg-page/75 group-data-scrolled/header:bg-surface/95',
    // Effects
    'shadow-none backdrop-blur-sm group-data-scrolled/header:shadow-md',
    // Transitions
    settle,
  ]}>
    <div class:list={[
      // Layout
      'flex items-center gap-4 max-md:flex-col max-md:gap-3',
      // Spacing
      'mr-auto max-md:mr-0',
    ]}>
      <a
        class:list={[
          // Colors
          'text-fg-1',
          // Typography
          'font-display text-h3 leading-none font-semibold tracking-display no-underline',
        ]}
        href="/"
      >{site.name}</a>
      {site.availability && (
        <a
          class:list={[
            // Layout
            'inline-flex items-center gap-1.75',
            // Sizing
            'h-6.5',
            // Spacing
            'px-2.5 translate-y-px',
            // Borders
            'rounded-full border-2 border-line group-data-scrolled/header:border-transparent',
            // Colors
            'bg-surface text-fg-1 hover:bg-sunken group-data-scrolled/header:bg-transparent group-data-scrolled/header:hover:bg-sunken',
            // Typography
            'font-body text-xs leading-none font-bold tracking-caps uppercase whitespace-nowrap no-underline',
            // Effects
            'shadow-md group-data-scrolled/header:shadow-none',
            // Transitions
            settle,
          ]}
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="size-2 rounded-full bg-moss-500" aria-hidden="true" />
          {site.availability}
        </a>
      )}
    </div>
    <nav class:list={[
      // Layout
      'inline-flex gap-1 max-md:hidden',
      // Sizing
      'max-w-full',
      // Spacing
      'p-1',
      // Borders
      'rounded-full border-3 border-line group-data-scrolled/header:border-transparent',
      // Colors
      'bg-surface group-data-scrolled/header:bg-transparent',
      // Effects
      'shadow-md group-data-scrolled/header:shadow-none',
      // Transitions
      settle,
    ]} aria-label="Main">
      {nav.map((n) => (
        <a
          class:list={[
            // Layout
            'relative isolate inline-flex items-center',
            // Sizing
            'h-9.5',
            // Spacing
            'px-4',
            // Borders
            'rounded-full border-2 border-transparent',
            // Colors
            n.id === current ? 'text-on-fill' : 'text-fg-2 hover:bg-sunken hover:text-fg-1',
            // Typography
            'font-body text-[15px] leading-none font-bold whitespace-nowrap no-underline',
            // Transitions
            'transition-colors duration-120',
          ]}
          href={n.href}
          aria-current={n.id === current ? 'page' : undefined}
        >
          {/* The pill morphs between pages via View Transitions (see global.css) */}
          {n.id === current && (
            <span
              class:list={[
                // Layout
                'absolute -inset-0.5 -z-10',
                // Borders
                'rounded-full border-2 border-line',
                // Colors
                'bg-mist-500',
                // Transitions
                '[view-transition-name:loam-tab-pill]',
              ]}
              aria-hidden="true"
            />
          )}
          <span class="relative" style={'view-transition-name: loam-tab-' + n.id}>{n.label}</span>
        </a>
      ))}
    </nav>
    <Button class="max-md:hidden" variant="secondary" size="sm" href={site.links.linkedin} external icon="linkedin" iconClass="loam-anim-hop">LinkedIn</Button>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
