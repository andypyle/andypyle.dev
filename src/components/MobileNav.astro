---
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';
import { buttonBase, buttonRaised } from './ui/button';
import { getSite } from '../lib/data';

const site = await getSite();
const { nav } = site;
const path = Astro.url.pathname;
const current = nav.find((n) => (n.href === '/' ? path === '/' : path.startsWith(n.href)))?.id;

// data-state on the root: unset (closed) → "open" → "closing" (while the exit animation plays) → unset.
// Items stagger in top-down and out bottom-up via --stagger-in / --stagger-out (read by animate-slide-*).
const animIn = 'group-data-[state=open]/mnav:animate-slide-in group-data-[state=closing]/mnav:animate-slide-out motion-reduce:animate-none!';
const bar = 'absolute left-px h-[3px] w-4.5 rounded-[2px] bg-current transition-[translate,rotate,scale,opacity] duration-320 ease-bounce motion-reduce:transition-none';
---
<div
  class:list={[
    // Group
    'group/mnav',
    // Layout
    'md:hidden',
    // ::before: faint radial shade behind the toggle so it reads over page content
    // (radial, so iOS Safari's floating toolbar can't expose a hard edge)
    'before:pointer-events-none before:fixed before:bottom-0.75 before:left-1/2 before:z-39',
    'before:h-28 before:w-90',
    'before:bg-[radial-gradient(closest-side,rgb(26_31_36/0.2),rgb(26_31_36/0.08)_60%,transparent)]',
    'before:-translate-x-1/2',
  ]}
  data-mnav
>
  <div
    class:list={[
      // Layout
      'fixed inset-0 z-40 hidden group-data-state/mnav:block',
      // Colors
      'bg-ink-900/40',
      // Effects
      'backdrop-blur-[3px]',
      // Animation
      'group-data-[state=open]/mnav:animate-fade-in group-data-[state=closing]/mnav:animate-fade-out motion-reduce:animate-none!',
    ]}
    data-mnav-close
  ></div>
  <button
    type="button"
    class:list={[
      // Base
      buttonBase,
      buttonRaised.md,
      // Layout
      'fixed inset-x-0 bottom-8 z-42',
      // Sizing
      'h-13.5 w-fit min-w-31',
      // Spacing
      'mx-auto px-5',
      // Borders
      'border-3 border-line',
      // Colors
      'bg-slate-700 text-slate-50 hover:bg-slate-500',
      // Typography
      'text-body',
    ]}
    aria-expanded="false"
    aria-controls="mnav-menu"
    data-mnav-toggle
  >
    <span class="relative inline-block size-5 flex-none" aria-hidden="true">
      <span
        class:list={[
          // Base
          bar,
          // Layout
          'top-0.75',
          // Transforms
          'group-data-[state=open]/mnav:translate-y-1.5 group-data-[state=open]/mnav:rotate-45',
        ]}
      ></span>
      <span
        class:list={[
          // Base
          bar,
          // Layout
          'top-2.25',
          // Effects
          'group-data-[state=open]/mnav:opacity-0',
          // Transforms
          'group-data-[state=open]/mnav:scale-x-0',
        ]}
      ></span>
      <span
        class:list={[
          // Base
          bar,
          // Layout
          'top-3.75',
          // Transforms
          'group-data-[state=open]/mnav:-translate-y-1.5 group-data-[state=open]/mnav:-rotate-45',
        ]}
      ></span>
    </span>
    <span data-mnav-label>Menu</span>
  </button>
  <nav
    class:list={[
      // Layout
      'fixed inset-x-4 bottom-26 z-41 hidden flex-col gap-1 group-data-state/mnav:flex',
      // Spacing
      'p-2.5',
      // Borders
      'rounded-xl border-3 border-line',
      // Colors
      'bg-surface',
      // Effects
      'shadow-lg',
      // Transforms
      'origin-bottom',
      // Animation
      'group-data-[state=open]/mnav:animate-pop-in group-data-[state=closing]/mnav:animate-pop-out motion-reduce:animate-none!',
    ]}
    aria-label="Main"
    id="mnav-menu"
  >
    {nav.map((n, i) => (
      <a
        class:list={[
          // Layout
          'flex items-center justify-between',
          // Sizing
          'min-h-14',
          // Spacing
          'px-4.5',
          // Borders
          'rounded-lg border-2',
          n.id === current ? 'border-line' : 'border-transparent',
          // Colors
          n.id === current ? 'bg-mist-500 text-on-fill' : 'text-fg-1 hover:bg-sunken',
          // Typography
          'font-display text-2xl font-semibold tracking-[-0.01em] no-underline',
          // Animation
          animIn,
        ]}
        href={n.href}
        aria-current={n.id === current ? 'page' : undefined}
        style={`--stagger-in:${40 + i * 40}ms;--stagger-out:${(nav.length - i) * 25}ms`}
      >
        {n.label}
        <Icon name="arrow-right" size={22} />
      </a>
    ))}
    <div
      class:list={[
        // Spacing
        'mt-1.5 px-2 pt-2.5 pb-1.5',
        // Borders
        'border-t-2 border-dashed border-subtle',
        // Animation
        animIn,
      ]}
      style={`--stagger-in:${40 + nav.length * 40}ms`}
    >
      <Button class="w-full rounded-lg!" variant="secondary" href={site.links.linkedin} external icon="linkedin" iconClass="loam-anim-hop">LinkedIn</Button>
    </div>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mnav]');
  if (root) {
    const btn = root.querySelector<HTMLElement>('[data-mnav-toggle]')!;
    const label = root.querySelector('[data-mnav-label]')!;
    // While open, the page behind the menu is inert so focus stays on the toggle and menu links
    const page = document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer');
    let timer: number | undefined;
    const set = (open: boolean) => {
      window.clearTimeout(timer);
      if (open) {
        root.dataset.state = 'open';
      } else if (root.dataset.state === 'open') {
        root.dataset.state = 'closing';
        timer = window.setTimeout(() => delete root.dataset.state, 260);
      }
      page.forEach((el) => { el.inert = open; });
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
    };
    btn.addEventListener('click', () => set(root.dataset.state !== 'open'));
    root.querySelector('[data-mnav-close]')?.addEventListener('click', () => set(false));
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || root.dataset.state !== 'open') return;
      set(false);
      btn.focus();
    });
  }
</script>
